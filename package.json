{
  "name": "resume-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:verify-store": "node --import ./scripts/alias-register.mjs scripts/verify-store.mjs",
    "db:verify-store2": "node --import ./scripts/alias-register.mjs scripts/verify-store2.mjs",
    "db:import": "node --import ./scripts/alias-register.mjs scripts/import-to-db.mjs",
    "db:verify-import": "node --import ./scripts/alias-register.mjs scripts/verify-import.mjs",
    "db:verify-auth": "node --import ./scripts/alias-register.mjs scripts/verify-auth.mjs && node --import ./scripts/alias-register.mjs scripts/verify-auth-adapter.mjs && node --import ./scripts/alias-register.mjs scripts/verify-auth-access.mjs",
    "db:users": "node --import ./scripts/alias-register.mjs scripts/list-users.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4"
  }
}
